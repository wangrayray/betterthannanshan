rules_version = '2';

// ============================================================
// 班務系統（退餐紀錄／外食訂購）Firestore 安全規則
//
// 角色判斷：
// - 伙委（staff）：Firebase Auth 帳號的 email，剛好在 /staff/{email} 底下有一筆文件，
//   即視為伙委，可讀寫所有 collection。
// - 同學（student）：Firebase Auth 帳號的 email 格式為 座號@yourclass.local
//   （網域字串需與 index.html 內的 CLASS_DOMAIN 常數一致）。
//   同學只能寫入「自己座號」對應的文件（訂餐選擇 lunch_choice/dinner_choice、
//   外食訂單 orders），且該座號必須已存在於 /students 名冊中才允許寫入。
// - 外食訂購人（event coordinator）：伙委在設定頁指定某個座號、效期 14 天，
//   期間內該座號的帳號可以完整管理 events（含建立/刪除活動、菜單、任何人的訂單），
//   但無法碰退餐紀錄、名冊、伙委名單等其他 collection。到期後自動失效，
//   不需要手動清除文件（規則會直接比對到期時間，過期文件視同無效）。
//
// 注意：CLASS_DOMAIN 這裡寫死在規則裡（下方 classDomain() 函式），
// 如果你把 index.html 裡的 CLASS_DOMAIN 改成別的字串，這裡也要跟著改。
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email;
    }

    // 依 Firestore 是否存在 /staff/{email} 文件來判斷是否為伙委
    function isStaff() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/staff/$(myEmail()));
    }

    // CLASS_DOMAIN：需與 index.html 中的常數一致
    function classDomain() {
      return 'yourclass.local';
    }

    function isStudentAccount() {
      return isSignedIn() && myEmail().matches('.*@' + classDomain());
    }

    function studentIdOf() {
      return myEmail().split('@')[0];
    }

    // 該座號是否已被伙委登記在名冊（/students/{studentId}）中
    function isRosterStudent() {
      return isStudentAccount() &&
        exists(/databases/$(database)/documents/students/$(studentIdOf()));
    }

    // 目標文件 id 是否等於「我自己的座號」
    function isOwnId(id) {
      return isStudentAccount() && id == studentIdOf();
    }

    // 我是否為目前有效（未過期）的外食訂購人
    function isEventCoordinator() {
      return isStudentAccount() &&
        exists(/databases/$(database)/documents/eventCoordinators/$(studentIdOf())) &&
        get(/databases/$(database)/documents/eventCoordinators/$(studentIdOf())).data.expiresAt > request.time;
    }

    // ---------------- 防止時間造假 + 惡意灌爆同一份文件 ----------------
    // 這兩個函式只用在「同學可以自己直接寫入」的高風險 collection
    // （lunch_choice／dinner_choice／orders）：這些文件的擁有者就是同學本人，
    // 一般的「只能寫自己座號」規則擋不住「本人用腳本狂洗自己那份紀錄」。
    //
    // hasFreshTimestamp()：強制 updatedAt 一定要是 request.time（伺服器當下
    // 時間），前端一律用 serverTimestamp() 送出。這樣就算有人打開 F12、複製
    // firebaseConfig、自己寫腳本呼叫 SDK 送資料，也沒辦法偽造成別的時間，
    // 也沒辦法乾脆不帶這個欄位（因為規則會直接拒絕）。
    //
    // isThrottled()：同一份文件距離上次更新如果還沒超過 1 秒，就拒絕這次寫入
    // （create 沒有「上一次」可比較，所以不受此限，只限制 update／delete）。
    // 這樣即使有人寫一支 while(true) 迴圈狂打同一位同學的紀錄，實際上一秒
    // 內最多只有 1 次會真的寫進去、算進計費用量，其餘全部在規則層被拒絕、
    // 不會產生額外的計費讀寫，避免把 Firebase 免費額度刷爆。
    // 舊資料（這幾條規則上線之前寫入的文件）updatedAt 還是字串、不是
    // Timestamp，get() 出來 `last is timestamp` 會是 false，此時視為「沒有
    // 節流資訊可比對」直接放行；一旦被寫入一次就會換成正確的 Timestamp，
    // 之後就會正常受到節流限制，不需要手動搬移舊資料。
    function hasFreshTimestamp() {
      return request.resource.data.updatedAt == request.time;
    }
    function isThrottled(existingData) {
      let last = existingData.get('updatedAt', null);
      return last is timestamp && request.time < last + duration.value(1, 's');
    }

    // ---------------- entries.lunch.choices / entries.dinner.choices 的欄位級權限 ----------------
    // 讀取量優化：原本「entries/{date}/lunch_choice/{座號}」每個人各自一份子文件，
    // 伙委頁要用 collectionGroup 一次讀「所有日期 × 全班」，等於幾百份小文件；
    // 改成把全班的點餐狀態合併存進 entries/{date} 這一份文件裡的
    // lunch.choices.{座號} / dinner.choices.{座號} 這兩個 map 欄位，
    // 伙委頁只需要監聽 entries 這個 collection（幾份文件），不用再另外監聽
    // lunch_choice/dinner_choice，讀取量從「幾百份」降到「幾份」。
    //
    // 因為多人共用同一份文件，同學不能再用「文件 id 是不是自己的座號」來判斷
    // 權限（現在大家都寫同一份文件），必須改成「只能改動 lunch/dinner 兩個
    // 頂層欄位其中一個，而且該欄位底下 choices map 只能新增/修改/刪除自己座號
    // 那一個 key」，其他人的資料、note/lastEditBy 等欄位完全不能碰。
    // 用 Map.diff().affectedKeys() 逐層比對前後差異來驗證這件事。
    function isValidStudentChoiceUpdate() {
      return isRosterStudent() && isValidChoiceEdit();
    }
    function isValidChoiceEdit() {
      // 一次只能改 lunch 或 dinner 其中一個頂層欄位，不能兩個一起改，
      // 也不能同時動到 note / lastEditBy / lastEditAt / date 等其他欄位。
      let changedTop = request.resource.data.diff(resource.data).affectedKeys();
      let onlyOneMeal = changedTop.size() == 1 && changedTop.hasAny(['lunch', 'dinner']);
      let meal = changedTop.hasAny(['lunch']) ? 'lunch' : 'dinner';
      return onlyOneMeal && isValidSeatEdit(meal);
    }
    // 拆成獨立函式：Firestore 規則單一函式最多只能宣告 10 個 let 變數，
    // isValidChoiceEdit() 裡面如果把 choices map 的檢查也全部攤開寫，會超過上限。
    function isValidSeatEdit(meal) {
      let sid = studentIdOf();
      let oldChoices = resource.data.get(meal, {}).get('choices', {});
      let newChoices = request.resource.data.get(meal, {}).get('choices', {});
      let changedSeats = newChoices.diff(oldChoices).affectedKeys();
      // choices map 裡被改動的 key，只能是自己的座號，不能碰別人的紀錄。
      let onlyOwnSeat = changedSeats.hasOnly([sid]);
      // 沿用同一份「同一筆紀錄距離上次更新要滿 1 秒」節流機制，防止惡意灌爆；
      // 因為現在是存在 choices map 裡的巢狀欄位，改成直接比對這個座號自己的
      // updatedAt，不受同一份文件裡其他座號寫入頻率的影響。用 .get(sid, {}) 而不是
      // 先判斷是否存在再取值，避免三元運算子裡混用 null 跟其他型別導致型別檢查出錯。
      let last = oldChoices.get(sid, {}).get('updatedAt', null);
      let notThrottled = !(last is timestamp && request.time < last + duration.value(1, 's'));
      let existsAfter = sid in newChoices;
      // 新增/修改：新的紀錄一定要帶 serverTimestamp()（跟外層 hasFreshTimestamp 邏輯一樣，
      // 防止偽造時間）。刪除（退選）：新的 choices map 裡已經沒有這個座號的 key。
      return onlyOwnSeat && notThrottled && (existsAfter
        ? newChoices.get(sid, {}).get('updatedAt', null) == request.time
        : (sid in oldChoices));
    }

    // ---------------- settings ----------------
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // ---------------- students（全班座號名冊） ----------------
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // ---------------- staff（伙委名單，文件 id = email） ----------------
    match /staff/{email} {
      // 只有伙委才能讀寫（讀取用於在設定頁列出目前伙委，若不需要可再放寬）
      allow read: if isStaff();
      allow write: if isStaff();
      // 注意：第一位伙委無法透過此規則自行建立，
      // 必須由專案擁有者在 Firebase Console 手動新增第一筆 staff 文件。
    }

    // ---------------- eventCoordinators（外食訂購人，文件 id = 座號） ----------------
    match /eventCoordinators/{seatNo} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // ---------------- entries（訂餐/退餐紀錄，依日期） ----------------
    // 全班的點餐/退餐狀態現在合併存在同一份文件的 lunch.choices / dinner.choices
    // map 欄位裡（取代原本一人一份子文件的 lunch_choice/dinner_choice），伙委可
    // 以完整讀寫；同學只能透過 isValidStudentChoiceUpdate() 改動自己座號那一個
    // key，其餘欄位（note、lastEditBy...）跟其他同學的資料完全不能碰。
    match /entries/{date} {
      allow read: if isSignedIn();
      allow create: if isStaff();
      allow delete: if isStaff();
      allow update: if isStaff() || isValidStudentChoiceUpdate();
    }

    // ---------------- events（外食訂購活動） ----------------
    // 伙委或目前有效的外食訂購人都可以完整管理活動、菜單、任何人的訂單
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isStaff() || isEventCoordinator();
    }

    // ---------------- 以下用 {path=**} 遞迴萬用字元 ----------------
    // 重要：app 裡用 collectionGroup() 一次讀取「所有日期/所有活動」底下的
    // lunch_choice / dinner_choice / menu / orders（例如伙委頁要同時看到全部
    // 日期的訂餐狀態）。Firestore 規定：collectionGroup() 查詢只吃「頂層」用
    // {path=**} 萬用字元寫的規則，寫在某個集合內部的巢狀 match（例如寫在
    // entries/{date} 或 events/{eventId} 裡面）只對「已知完整路徑」單一文件的
    // 讀寫有效，對 collectionGroup 查詢完全不會生效、會直接被拒絕（但因為前端
    // 用的是即時監聽 onSnapshot，錯誤不會跳出明顯的例外，看起來就像是「資料寫
    // 進去了，畫面卻永遠不會更新」）。這正是先前系統看起來「沒有反應」的真正
    // 原因，因此以下規則一律寫在最外層，不要巢狀寫在其他 match 裡面。
    // 舊版「一人一份子文件」的 lunch_choice/dinner_choice：資料已搬到
    // entries/{date} 的 lunch.choices/dinner.choices 欄位，前端不再寫入這裡，
    // 只保留讀取權限給搬移工具（migrateLegacyChoices）用一次性讀取，
    // 寫入只留給伙委（方便之後手動清除舊資料），同學不再能直接寫這裡。
    match /{path=**}/lunch_choice/{sid} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /{path=**}/dinner_choice/{sid} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /{path=**}/menu/{itemId} {
      allow read: if isSignedIn();
      allow write: if isStaff() || isEventCoordinator();
    }

    match /{path=**}/orders/{sid} {
      allow read: if isSignedIn();
      allow create: if (isStaff() || isEventCoordinator() || (isOwnId(sid) && isRosterStudent())) && hasFreshTimestamp();
      allow update: if (isStaff() || isEventCoordinator() || (isOwnId(sid) && isRosterStudent())) && hasFreshTimestamp() && !isThrottled(resource.data);
      allow delete: if (isStaff() || isEventCoordinator() || (isOwnId(sid) && isRosterStudent())) && !isThrottled(resource.data);
    }

    // 餐廳推薦：任何在名冊上的同學、伙委、外食訂購人都可以推薦/+1（累加次數），
    // 但只有伙委／外食訂購人可以刪除（清掉重複或不合適的建議）。
    match /{path=**}/recommendations/{recId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff() || isEventCoordinator() || isRosterStudent();
      allow delete: if isStaff() || isEventCoordinator();
    }

    // 預設拒絕所有其他路徑
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
